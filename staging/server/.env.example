# ── BotDesk V2 Server Environment ──
PORT=4000

# JWT Authentication (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change_me_to_random_secret
JWT_REFRESH_SECRET=change_me_to_another_random_secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS (comma-separated origins for production)
CORS_ORIGINS=http://localhost:5174,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Encryption key for sensitive DB fields (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=change_me_to_random_key
